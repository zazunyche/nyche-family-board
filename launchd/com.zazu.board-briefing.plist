<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.zazu.board-briefing.plist
  Fires daily at 7:00am — augments Zazu's existing morning briefing with board state.
  Install: cp launchd/com.zazu.board-briefing.plist ~/Library/LaunchAgents/
           launchctl load ~/Library/LaunchAgents/com.zazu.board-briefing.plist
  Test:    launchctl start com.zazu.board-briefing
  Logs:    /Users/zazunyche/Documents/src/family-board/logs/board-briefing.log
           /Users/zazunyche/Documents/src/family-board/logs/board-briefing-launchd.log
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.zazu.board-briefing</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-i</string>
    <string>/bin/bash</string>
    <string>/Users/zazunyche/Documents/src/family-board/scripts/board-briefing.sh</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>7</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <!-- Persistent log location (survives reboots unlike /tmp) -->
  <key>StandardOutPath</key>
  <string>/Users/zazunyche/Documents/src/family-board/logs/board-briefing-launchd.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/zazunyche/Documents/src/family-board/logs/board-briefing-launchd.log</string>

  <key>RunAtLoad</key>
  <false/>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/zazunyche</string>
    <!-- npm-global/bin required for nodemailer and other npm tools -->
    <key>PATH</key>
    <string>/Users/zazunyche/.npm-global/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
