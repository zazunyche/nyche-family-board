<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.zazu.board-midnight-commit.plist
  Commits board-data.json to git at midnight if there are changes.
  Install: cp launchd/com.zazu.board-midnight-commit.plist ~/Library/LaunchAgents/
           launchctl load ~/Library/LaunchAgents/com.zazu.board-midnight-commit.plist
  Logs:    /Users/zazunyche/Documents/src/family-board/logs/git.log
           /Users/zazunyche/Documents/src/family-board/logs/midnight-commit-launchd.log
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.zazu.board-midnight-commit</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/zazunyche/Documents/src/family-board/scripts/midnight-commit.sh</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>0</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <!-- Persistent log location (survives reboots unlike /tmp) -->
  <key>StandardOutPath</key>
  <string>/Users/zazunyche/Documents/src/family-board/logs/midnight-commit-launchd.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/zazunyche/Documents/src/family-board/logs/midnight-commit-launchd.log</string>

  <key>RunAtLoad</key>
  <false/>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/zazunyche</string>
    <key>PATH</key>
    <string>/Users/zazunyche/.npm-global/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
