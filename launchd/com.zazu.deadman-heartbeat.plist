<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.zazu.deadman-heartbeat.plist
  Runs scripts/deadman-heartbeat.sh every 5 minutes: pings Healthchecks.io so that
  ABSENCE of a ping alerts Dad (dead-man's switch). Safe no-op until the ping URLs
  are set in ~/.zazu-config.
  Install: cp to ~/Library/LaunchAgents/ && launchctl load it.
  (For pre-login/boot coverage, promote to /Library/LaunchDaemons with sudo later.)
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.zazu.deadman-heartbeat</string>
  <!-- ROOT CAUSE of the Oct-30 2026 EX_CONFIG(78) breakage (found 2026-11-06):
       StandardOut/ErrPath pointed into ~/Documents, which is TCC-protected.
       launchd OPENS the stdout/stderr files BEFORE exec'ing the program; after
       the Oct-30 reboot it could no longer open them there, so the whole job
       failed with EX_CONFIG(78) and the script NEVER ran (that's why the log
       files stayed empty). THE FIX: log to /tmp (not TCC-protected), matching
       the working com.zazu.scheduler / board-server daemons. See below.
       NOTE: the ProgramArguments form was a RED HERRING — all three forms
       (["/bin/bash",<script>], bare script, ~/.claude wrapper) fail identically
       while the log path is in ~/Documents, and all succeed once it is /tmp.
       Keeping ["/bin/bash", <script>] to match the sibling interval agents. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/zazunyche/Documents/src/family-board/scripts/deadman-heartbeat.sh</string>
  </array>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/zazu-deadman-heartbeat.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/zazu-deadman-heartbeat.log</string>
</dict>
</plist>
