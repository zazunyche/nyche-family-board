<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.zazu.health-check.plist
  Fires daily at 10:00am and 9:00pm — checks delivery status, log errors, server health.
  Sends iMessage to Dad if anything is stale or errored.
  Install: cp launchd/com.zazu.health-check.plist ~/Library/LaunchAgents/
           launchctl load ~/Library/LaunchAgents/com.zazu.health-check.plist
  Test:    launchctl start com.zazu.health-check
  Logs:    /Users/zazunyche/Documents/src/family-board/logs/health-check.log
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.zazu.health-check</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/zazunyche/Documents/src/family-board/scripts/health-check.sh</string>
  </array>

  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key>
      <integer>10</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
    <dict>
      <key>Hour</key>
      <integer>21</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/zazunyche/.npm-global/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>HOME</key>
    <string>/Users/zazunyche</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/zazunyche/Documents/src/family-board/logs/health-check.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/zazunyche/Documents/src/family-board/logs/health-check.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
