<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.zazu.board-reminders.plist
  Fires daily at 8:00am — sends any scheduled reminders via Zazu's iMessage channel.
  Reminders are stored in board-data.json → pendingReminders[].
  Install: cp launchd/com.zazu.board-reminders.plist ~/Library/LaunchAgents/
           launchctl load ~/Library/LaunchAgents/com.zazu.board-reminders.plist
  Test:    launchctl start com.zazu.board-reminders
  Logs:    /tmp/zazu-board-reminders.stdout.log
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.zazu.board-reminders</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/zazunyche/Documents/src/family-board/scripts/board-reminders.sh</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>8</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/tmp/zazu-board-reminders.stdout.log</string>

  <key>StandardErrorPath</key>
  <string>/tmp/zazu-board-reminders.stderr.log</string>

  <key>RunAtLoad</key>
  <false/>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/zazunyche</string>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
  </dict>
</dict>
</plist>
