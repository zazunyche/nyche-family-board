<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.zazu.board-reminders.plist
  Fires daily at 8:00am — sends any scheduled reminders via Zazu's iMessage channel.
  Reminders are stored in board-data.json → pendingReminders[].
  Install: cp launchd/com.zazu.board-reminders.plist ~/Library/LaunchAgents/
           launchctl load ~/Library/LaunchAgents/com.zazu.board-reminders.plist
  Test:    launchctl start com.zazu.board-reminders
  Logs:    /Users/zazunyche/Documents/src/family-board/logs/board-reminders.log
           /Users/zazunyche/Documents/src/family-board/logs/board-reminders-launchd.log
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.zazu.board-reminders</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-i</string>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>for i in 1 2 3 4 5; do /bin/bash "$1" &amp;&amp; exit 0; echo "[retry] attempt $i failed (EINTR or similar), retrying in 3s" 1&gt;&amp;2; sleep 3; done; exit 1</string>
    <string>_</string>
    <string>/Users/zazunyche/Documents/src/family-board/scripts/board-reminders.sh</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>8</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <!-- Persistent log location (survives reboots unlike /tmp) -->
  <key>StandardOutPath</key>
  <string>/Users/zazunyche/Documents/src/family-board/logs/board-reminders-launchd.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/zazunyche/Documents/src/family-board/logs/board-reminders-launchd.log</string>

  <key>RunAtLoad</key>
  <false/>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/zazunyche</string>
    <!-- npm-global/bin required for node tools -->
    <key>PATH</key>
    <string>/Users/zazunyche/.npm-global/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
